# Foggy server
NODE_ENV=development
HOST=0.0.0.0
PORT=7400
# Leave blank to make remote browsers load Vite from the Foggy request host.
VITE_DEV_SERVER=

# Server-side JSON connection store. Relative paths resolve from Foggy's
# working directory. The file is created with mode 0600 when it is missing.
FOGGY_CONFIG_FILE=./config/foggy.json

# Restart-persistent authenticated sessions. The file contains only hashed
# bearer IDs and session metadata; credentials remain in FOGGY_CONFIG_FILE.
FOGGY_SESSION_FILE=./config/sessions.json
# Browser-cookie and server-side session lifetime (default: 1 hour).
FOGGY_SESSION_TTL_MS=3600000

# Snapin installer proxy limits. Uploads are written to the operating system's
# temporary directory and deleted after FOG accepts or rejects the request.
FOGGY_SNAPIN_UPLOAD_MAX_BYTES=2147483648
FOGGY_SNAPIN_UPLOAD_TIMEOUT_MS=1800000

# Optional first-run seed for the JSON store. Once Foggy creates the config,
# manage additional connections through Add server. Do not append /api.
# Example: https://fog.example.test/fog
FOG_SERVER_NAME=
FOG_BASE_URL=

# Header-ready global application token copied from the FOG UI. Foggy sends
# this value verbatim; do not encode it again. Technicians enter their normal
# FOG username and password on Foggy's sign-in page.
FOG_API_TOKEN=

# Request timeout in milliseconds.
FOG_REQUEST_TIMEOUT_MS=10000
