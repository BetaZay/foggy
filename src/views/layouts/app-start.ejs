<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#111817">
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg">
    <title><%= title %> · Foggy</title>
    <% for (const href of assets.styles) { %>
      <link rel="stylesheet" href="<%= href %>">
    <% } %>
  </head>
  <body
    x-data="{ sidebarOpen: false, serverManagerOpen: false }"
    @keydown.escape.window="sidebarOpen = false; serverManagerOpen = false"
  >
    <div class="min-h-screen">
      <div
        x-cloak
        x-show="sidebarOpen"
        x-transition.opacity
        class="fixed inset-0 z-30 bg-stone-950/40 lg:hidden"
        @click="sidebarOpen = false"
      ></div>
      <%- include('../partials/sidebar') %>
      <%- include('../partials/server-manager-modal') %>
      <div class="min-w-0 lg:pl-64">
        <header class="app-topbar">
          <div class="flex min-w-0 items-center gap-3">
            <button class="button-ghost -ml-2 px-2 lg:hidden" @click="sidebarOpen = true" aria-label="Open navigation">
              <%- include('../components/icon', { name: 'menu', className: 'size-5' }) %>
            </button>
            <div class="min-w-0">
              <div class="truncate text-sm font-semibold text-ink-950"><%= title %></div>
              <div class="hidden text-xs text-stone-500 sm:block">Foggy operations console</div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="hidden items-center gap-2 rounded-lg border border-stone-200 bg-white px-3 py-2 text-xs text-stone-600 shadow-sm transition hover:border-stone-300 hover:bg-stone-50 sm:flex"
              @click="serverManagerOpen = true"
              hx-get="/servers/manage?returnTo=<%= encodeURIComponent(typeof fogServerReturnTo !== 'undefined' ? fogServerReturnTo : '/') %>"
              hx-target="#server-manager-content"
              aria-label="Manage FOG server connections"
            >
              <span class="size-1.5 rounded-full <%= typeof fogConfigured !== 'undefined' && fogConfigured ? 'bg-fog-500 ring-2 ring-fog-100' : 'bg-stone-400' %>"></span>
              <%- include('../components/icon', { name: 'server', className: 'size-4 text-stone-400' }) %>
              <span><%= typeof fogServerName !== 'undefined' && fogServerName ? fogServerName : 'FOG server' %></span>
            </button>
          </div>
        </header>
        <main class="page-container">
