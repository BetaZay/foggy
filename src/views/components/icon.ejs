  <% } else if (name === 'deploy') { %>
    <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19v2h16v-2"/>
  <% } else if (name === 'capture') { %>
    <path d="M12 17V5m0 0 4 4m-4-4L8 9M4 19v2h16v-2"/>
  <% } else if (name === 'tasks') { %>
    <path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/>
