<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
  <div>
    <% if (eyebrow) { %><p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-fog-700"><%= eyebrow %></p><% } %>
    <h1 class="text-2xl font-bold tracking-[-0.03em] text-ink-950 sm:text-[28px]"><%= heading %></h1>
    <% if (description) { %><p class="mt-2 max-w-3xl text-sm leading-6 text-stone-500"><%= description %></p><% } %>
  </div>
  <% if (action) { %><div class="shrink-0"><%- action %></div><% } %>
</div>
