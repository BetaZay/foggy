<% const badgeClass = { success: 'badge-success', warning: 'badge-warning', danger: 'badge-danger', info: 'badge-info', neutral: 'badge-neutral' }[tone] || 'badge-neutral'; %>
<span class="<%= badgeClass %>"><span class="size-1.5 rounded-full bg-current opacity-70"></span><%= label || 'Unknown' %></span>
