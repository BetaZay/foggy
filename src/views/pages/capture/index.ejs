<%- include('../../layouts/app-start') %>
<%- include('../../components/page-header', { eyebrow: 'Guided imaging', heading: 'Capture a computer', description: 'Choose the source computer and the existing image definition that should receive its disk image.', action: '' }) %>
<% if (typeof imageCreated !== 'undefined' && imageCreated) { %><%- include('../../components/alert', { heading: 'Image definition created:', message: 'The new definition is selected below. Choose the source computer and review the capture.', tone: 'success' }) %><% } %>
<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot capture:</strong> <%= formError %></div><% } %>
<form method="post" action="/capture" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel overflow-hidden"><div class="panel-header"><div><div class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-fog-700 text-xs font-bold text-white">1</span><h2 class="section-title">Select the source computer</h2></div><p class="section-description mt-1">Computers with an active task cannot start a capture.</p></div></div>
    <% if (!computers.length) { %><div class="p-5 text-sm text-stone-500">No registered computers are available.</div><% } else { %><div class="grid sm:grid-cols-2 xl:grid-cols-3"><% for (const computer of computers) { %><label class="flex items-start gap-3 border-b border-stone-100 px-5 py-4 transition <%= computer.hasActiveTask ? 'cursor-not-allowed bg-stone-50 opacity-65' : 'cursor-pointer hover:bg-fog-50/50 has-[:checked]:bg-fog-50' %> sm:odd:border-r xl:[&:not(:nth-child(3n))]:border-r"><input class="mt-1 size-4 accent-fog-700" type="radio" name="hostId" value="<%= computer.id %>" <%= Number(values.hostId) === computer.id ? 'checked' : '' %> <%= computer.hasActiveTask ? 'disabled' : '' %> required><span class="min-w-0 flex-1"><span class="flex items-center justify-between gap-2"><span class="truncate text-sm font-semibold text-ink-950"><%= computer.name || 'Unnamed host' %></span><% if (computer.hasActiveTask) { %><span class="badge-warning">Busy</span><% } %></span><span class="mt-0.5 block truncate font-mono text-[11px] text-stone-500"><%= computer.primaryMac || 'No MAC' %></span><span class="mt-1 block truncate text-xs text-stone-400"><%= computer.model || computer.imageName || 'No hardware details' %></span></span></label><% } %></div><% } %>
  </section>

  <section class="panel overflow-hidden"><div class="panel-header"><div><div class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-fog-700 text-xs font-bold text-white">2</span><h2 class="section-title">Select the destination image</h2></div><p class="section-description mt-1">Protected and disabled images are shown but cannot be overwritten.</p></div><a class="button-secondary" href="/images/new">Create new image</a></div>
    <% if (!images.length) { %><div class="p-5 text-sm text-red-700">No image definitions exist. New-image creation is the next Capture capability.</div><% } else { %><div class="grid gap-3 p-5 md:grid-cols-2 xl:grid-cols-3"><% for (const image of images) { const unavailable = !image.isEnabled || image.isProtected; %><label class="rounded-xl border border-stone-200 p-4 transition <%= unavailable ? 'cursor-not-allowed bg-stone-50 opacity-65' : 'cursor-pointer hover:border-fog-400 hover:bg-fog-50/40 has-[:checked]:border-fog-600 has-[:checked]:bg-fog-50 has-[:checked]:ring-1 has-[:checked]:ring-fog-600' %>"><div class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="radio" name="imageId" value="<%= image.id %>" <%= Number(values.imageId) === image.id ? 'checked' : '' %> <%= unavailable ? 'disabled' : '' %> required><span class="min-w-0"><span class="flex items-center gap-2"><span class="truncate text-sm font-semibold text-ink-950"><%= image.name %></span><% if (image.isProtected) { %><span class="badge-warning">Protected</span><% } else if (!image.isEnabled) { %><span class="badge-neutral">Disabled</span><% } %></span><span class="mt-1 block text-xs leading-5 text-stone-500"><%= image.description || image.operatingSystem || 'No description' %></span><span class="mt-2 block text-[11px] text-stone-400"><%= image.imageType || 'Image' %> · <%= image.storageGroup || 'Default storage' %></span></span></div></label><% } %></div><% } %>
  </section>

  <section class="panel overflow-hidden"><div class="panel-header"><div><div class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-fog-700 text-xs font-bold text-white">3</span><h2 class="section-title">Capture options</h2></div></div>
    <div class="grid gap-4 p-5 md:grid-cols-2"><label class="flex items-start gap-3 rounded-xl border border-stone-200 p-4"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="wake" value="1" <%= values.wake ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Wake the computer</span><span class="mt-1 block text-xs text-stone-500">Send Wake-on-LAN when capture is queued.</span></span></label><label class="flex items-start gap-3 rounded-xl border border-stone-200 p-4"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="shutdown" value="1" <%= values.shutdown ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Shut down afterward</span><span class="mt-1 block text-xs text-stone-500">Ask FOG to shut down after capture completes.</span></span></label></div>
  </section>

  <section class="panel overflow-hidden"><div class="space-y-4 p-5 sm:p-6"><div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-950"><strong>Overwrites stored image data:</strong> A successful capture replaces the selected image's data on FOG storage with the source computer's current disk contents. If assignment succeeds but task creation fails, Foggy reports that split result without attempting a racing rollback.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">I reviewed the source computer and destination image, and I authorize this capture.</span></label></div><div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="/">Cancel</a><button class="button-danger" type="submit">Queue capture</button></div></section>
</form>
<%- include('../../layouts/app-end') %>
