<%- include('../../layouts/app-start') %>
<%- include('../../components/page-header', { eyebrow: 'Capture request', heading: result.status === 'queued' ? 'Capture queued' : 'Capture not queued', description: `${result.host.name} → ${result.image.name}`, action: '<a class="button-secondary" href="/capture">Start another capture</a>' }) %>
<% if (result.status === 'queued') { %><%- include('../../components/alert', { heading: 'Capture queued:', message: result.message, tone: 'success' }) %><% } else { %><%- include('../../components/alert', { heading: 'Review required:', message: result.message }) %><% } %>
<section class="panel max-w-3xl overflow-hidden"><div class="panel-header"><div><h2 class="section-title"><%= result.host.name %></h2><p class="section-description mt-0.5"><%= result.host.primaryMac || 'No primary MAC' %></p></div><%- include('../../components/badge', { label: result.status === 'queued' ? 'Queued' : 'Failed', tone: result.status === 'queued' ? 'success' : 'danger' }) %></div><dl class="grid gap-6 p-5 sm:grid-cols-2 sm:p-6"><div><dt class="meta-label">Destination image</dt><dd class="meta-value"><%= result.image.name %></dd></div><div><dt class="meta-label">Image assignment changed</dt><dd class="meta-value"><%= result.imageChanged ? 'Yes' : 'No' %></dd></div><div><dt class="meta-label">Result stage</dt><dd class="meta-value capitalize"><%= result.stage.replace('-', ' ') %></dd></div><div><dt class="meta-label">Next step</dt><dd class="meta-value"><%= result.status === 'queued' ? 'Boot or wake the computer' : 'Review the computer and image assignment' %></dd></div></dl></section>
<div class="mt-6 flex gap-3"><a class="button-secondary" href="/computers/<%= result.host.id %>">View computer</a><a class="button-primary" href="/tasks">View tasks</a></div>
<%- include('../../layouts/app-end') %>
