<%- include('../../layouts/app-start') %>
<div class="mb-5"><a class="button-ghost -ml-3" href="/groups/<%= group.id %>"><%- include('../../components/icon', { name: 'arrow-left', className: 'size-4' }) %>Back to <%= group.name %></a></div>
<%- include('../../components/page-header', { eyebrow: 'Group management', heading: `Manage ${group.name} membership`, description: 'Select the computers that should belong to this FOG group.', action: '' }) %>
<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Membership was not fully saved:</strong> <%= formError %></div><% } %>
<form method="post" action="/groups/<%= group.id %>/members" class="max-w-5xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel overflow-hidden">
    <div class="panel-header"><div><h2 class="section-title">Registered computers</h2><p class="section-description mt-0.5"><%= selectedIds.size %> of <%= computers.length %> currently selected</p></div></div>
    <% if (!computers.length) { %><div class="p-5 text-sm text-stone-500">No registered computers are available.</div><% } else { %><div class="grid border-b border-stone-200 sm:grid-cols-2 xl:grid-cols-3"><% for (const computer of computers) { %><label class="flex cursor-pointer items-start gap-3 border-b border-stone-100 px-5 py-4 transition hover:bg-fog-50/50 sm:odd:border-r xl:[&:not(:nth-child(3n))]:border-r"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="hostIds" value="<%= computer.id %>" <%= selectedIds.has(computer.id) ? 'checked' : '' %>><span class="min-w-0"><span class="block truncate text-sm font-semibold text-ink-950"><%= computer.name || 'Unnamed host' %></span><span class="mt-0.5 block truncate font-mono text-[11px] text-stone-500"><%= computer.primaryMac || 'No MAC' %></span><span class="mt-1 block truncate text-xs text-stone-400"><%= computer.model || computer.imageName || 'No hardware details' %></span></span></label><% } %></div><% } %>
    <div class="space-y-4 p-5 sm:p-6"><div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong>Membership only:</strong> This changes which computers belong to the group. It does not deploy an image or retroactively copy group settings.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Apply this complete membership list to FOG and verify the result.</span></label></div>
    <div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="/groups/<%= group.id %>">Cancel</a><button class="button-primary" type="submit">Save membership</button></div>
  </section>
</form>
<%- include('../../layouts/app-end') %>
