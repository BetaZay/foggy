<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot save this group:</strong> <%= formError %></div><% } %>
<form method="post" action="<%= action %>" class="max-w-3xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel overflow-hidden">
    <div class="panel-header"><div><h2 class="section-title">Group details</h2><p class="section-description mt-0.5">A group is an organizational container for registered computers.</p></div></div>
    <div class="grid gap-6 p-5 sm:p-6">
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="name">Group name</label><input class="input <%= errors.name ? 'border-red-400' : '' %>" id="name" name="name" maxlength="50" value="<%= values.name %>" autofocus required><p class="mt-1.5 text-xs text-stone-500">Must be unique on this FOG server.</p><% if (errors.name) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.name %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="description">Description</label><textarea class="input min-h-28 py-3" id="description" name="description" rows="4"><%= values.description %></textarea></div>
    </div>
    <% if (requiresConfirmation) { %><div class="space-y-4 border-t border-stone-200 p-5 sm:p-6"><div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm leading-6 text-sky-950"><strong>Metadata only:</strong> This changes the group record. It does not apply boot, image, Active Directory, printer, Snapin, or client settings to member computers.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Apply this name and description to the group.</span></label></div><% } %>
    <div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="<%= cancelHref %>">Cancel</a><button class="button-primary" type="submit"><%= submitLabel %></button></div>
  </section>
</form>
