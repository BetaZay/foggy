<div>
  <div class="flex items-start justify-between gap-4 border-b border-stone-200 px-5 py-5 sm:px-6">
    <div><p class="text-[11px] font-bold uppercase tracking-[0.14em] text-fog-700">Connections</p><h2 class="mt-1 text-xl font-bold tracking-[-0.025em] text-ink-950">FOG servers</h2><p class="mt-1 text-sm text-stone-500">Choose where Foggy connects and manage server-side API credentials.</p></div>
    <button class="button-ghost -mr-2 -mt-2 size-10 p-0" type="button" aria-label="Close server manager" @click="serverManagerOpen = false">×</button>
  </div>
  <div class="max-h-[55vh] space-y-3 overflow-y-auto p-5 sm:p-6">
    <% if (!servers.length) { %><div class="rounded-xl border border-dashed border-stone-300 bg-stone-50 px-5 py-8 text-center"><div class="mx-auto grid size-10 place-items-center rounded-xl bg-stone-200 text-stone-500"><%- include('../../components/icon', { name: 'server', className: 'size-5' }) %></div><h3 class="mt-3 text-sm font-semibold text-stone-800">No FOG servers</h3><p class="mt-1 text-xs leading-5 text-stone-500">Add the first connection to continue.</p></div><% } %>
    <% for (const server of servers) { %>
      <div class="flex flex-col gap-4 rounded-xl border p-4 sm:flex-row sm:items-center sm:justify-between <%= server.id === currentServerId ? 'border-fog-300 bg-fog-50/60' : 'border-stone-200 bg-white' %>">
        <div class="min-w-0"><div class="flex items-center gap-2"><span class="size-2 rounded-full <%= server.setupRequired ? 'bg-amber-400' : server.id === currentServerId ? 'bg-emerald-500' : 'bg-stone-300' %>"></span><h3 class="truncate text-sm font-semibold text-ink-950"><%= server.name %></h3><% if (server.id === currentServerId) { %><span class="badge-neutral">Current</span><% } %></div><p class="mt-1 truncate pl-4 text-xs text-stone-500"><%= server.baseUrl %></p><% if (server.setupRequired) { %><p class="mt-1 pl-4 text-xs font-medium text-amber-700">User token required</p><% } %></div>
        <div class="flex shrink-0 items-center gap-2">
          <button class="button-secondary min-h-9 px-3 py-1.5 text-xs" type="button" hx-get="/servers/<%= server.id %>/edit?modal=1" hx-target="#server-manager-content">Configure</button>
          <% if (signedIn && server.id !== currentServerId) { %><form method="post" action="/servers/select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="serverId" value="<%= server.id %>"><input type="hidden" name="returnTo" value="<%= returnTo %>"><button class="button-primary min-h-9 px-3 py-1.5 text-xs" type="submit">Sign in</button></form><% } else if (!signedIn) { %><a class="button-primary min-h-9 px-3 py-1.5 text-xs" href="/login?server=<%= server.id %>">Sign in</a><% } %>
        </div>
      </div>
    <% } %>
  </div>
  <div class="flex items-center justify-between gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:px-6"><p class="hidden text-xs text-stone-500 sm:block">Tokens stay in Foggy's protected config.</p><button class="button-primary" type="button" hx-get="/servers/new?modal=1" hx-target="#server-manager-content"><span aria-hidden="true">+</span>Add server</button></div>
</div>
