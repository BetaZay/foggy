<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= title %> · Foggy</title>
    <% for (const href of assets.styles) { %><link rel="stylesheet" href="<%= href %>"><% } %>
  </head>
  <body>
    <main class="flex min-h-screen items-center justify-center px-5 py-10"><div class="w-full max-w-2xl overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-xl"><%- include('./form', { modal: false }) %></div></main>
    <% for (const src of assets.scripts) { %><script type="module" src="<%= src %>"></script><% } %>
  </body>
</html>
