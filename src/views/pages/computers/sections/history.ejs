<section id="activity" class="scroll-mt-24">
  <div class="mb-4"><h2 class="section-title">Activity and history</h2><p class="section-description mt-0.5">Imaging, user sessions, Snapin results, and virus detections recorded by FOG.</p></div>
  <% if (sectionErrors.history) { %><%- include('../../../components/alert', { message: sectionErrors.history }) %><% } %>
  <div class="grid gap-5 xl:grid-cols-2">
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Imaging history</h3><p class="section-description mt-0.5"><%= history.imaging.length %> records</p></div></div><div class="divide-y divide-stone-100">
      <% if (!history.imaging.length) { %><div class="p-5 text-sm text-stone-500">No imaging history found.</div><% } else { %><% for (const item of history.imaging.slice(0, 10)) { %><div class="flex items-start justify-between gap-4 px-5 py-3.5"><div><div class="text-sm font-semibold text-ink-950"><%= item.imageName || 'Unknown image' %></div><div class="mt-0.5 text-xs text-stone-500"><%= item.type || 'Imaging' %><%= item.createdBy ? ` · ${item.createdBy}` : '' %></div></div><div class="text-right text-xs text-stone-500"><div><%= formatDate(item.startedAt) %></div><% if (item.finishedAt) { %><div class="mt-0.5">Finished <%= formatDate(item.finishedAt) %></div><% } %></div></div><% } %><% } %>
    </div></article>
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Login history</h3><p class="section-description mt-0.5"><%= history.logins.length %> client events</p></div></div><div class="divide-y divide-stone-100">
      <% if (!history.logins.length) { %><div class="p-5 text-sm text-stone-500">No login history found.</div><% } else { %><% for (const item of history.logins.slice(0, 12)) { %><div class="flex items-center justify-between gap-4 px-5 py-3"><div class="flex items-center gap-3"><%- include('../../../components/badge', { label: item.actionLabel, tone: item.actionLabel === 'Login' ? 'success' : 'neutral' }) %><span class="text-sm font-semibold text-ink-950"><%= item.username || 'Unknown user' %></span></div><span class="text-xs text-stone-500"><%= formatDate(item.occurredAt) %></span></div><% } %><% } %>
    </div></article>
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Snapin history</h3><p class="section-description mt-0.5"><%= history.snapinTasks.length %> task results</p></div></div><div class="divide-y divide-stone-100">
      <% if (!history.snapinTasks.length) { %><div class="p-5 text-sm text-stone-500">No Snapin task history found.</div><% } else { %><% for (const item of history.snapinTasks.slice(0, 10)) { %><div class="flex items-start justify-between gap-4 px-5 py-3.5"><div><div class="text-sm font-semibold text-ink-950"><%= item.snapin.name || 'Unknown Snapin' %></div><div class="mt-0.5 text-xs text-stone-500"><%= item.details || item.state.name || 'No return details' %></div></div><div class="text-right"><%- include('../../../components/badge', { label: item.returnCode === 0 ? 'Success' : item.state.name || `Code ${item.returnCode}`, tone: item.returnCode === 0 ? 'success' : 'warning' }) %><div class="mt-1 text-xs text-stone-500"><%= formatDate(item.completedAt || item.checkedInAt) %></div></div></div><% } %><% } %>
    </div></article>
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Virus history</h3><p class="section-description mt-0.5"><%= history.viruses.length %> detections for current MAC addresses</p></div></div><div class="divide-y divide-stone-100">
      <% if (!history.viruses.length) { %><div class="p-5 text-sm text-stone-500">No virus detections found.</div><% } else { %><% for (const item of history.viruses.slice(0, 10)) { %><div class="flex items-start justify-between gap-4 px-5 py-3.5"><div><div class="text-sm font-semibold text-red-800"><%= item.name || 'Detection' %></div><div class="mt-0.5 break-all text-xs text-stone-500"><%= item.file || item.mac %></div></div><span class="text-xs text-stone-500"><%= formatDate(item.occurredAt) %></span></div><% } %><% } %>
    </div></article>
  </div>
</section>
