<section id="active-directory" x-data='{ enabled: <%= adValues.enabled ? "true" : "false" %>, useDefaultPassword: <%= adValues.useDefaultPassword && adDefaults.hasPassword ? "true" : "false" %>, hasDefaultPassword: <%= adDefaults.hasPassword ? "true" : "false" %> }'>
  <div class="mb-5"><h2 class="section-title">Active Directory</h2><p class="section-description mt-0.5">Configure the modern FOG Client to join this computer to a domain after deployment.</p></div>
  <% if (adFormError) { %><div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot save:</strong> <%= adFormError %> Password fields are always cleared after submission.</div><% } %>
  <form method="post" action="/computers/<%= computer.id %>/active-directory" class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel overflow-hidden">
      <div class="panel-header"><div><h3 class="section-title">Domain join settings</h3><p class="section-description mt-0.5">Equivalent modern-client fields from FOG’s Host Active Directory tab.</p></div><%- include('../../../components/badge', { label: adValues.enabled ? 'Enabled' : 'Disabled', tone: adValues.enabled ? 'success' : 'neutral' }) %></div>
      <div class="space-y-5 p-5 sm:p-6">
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="enabled" value="1" x-model="enabled" @change="if (enabled) { if (!$refs.domain.value) $refs.domain.value = $refs.domain.dataset.default; if (!$refs.ou.value) $refs.ou.value = $refs.ou.dataset.default; if (!$refs.username.value) $refs.username.value = $refs.username.dataset.default; if (hasDefaultPassword) useDefaultPassword = true }" <%= adValues.enabled ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-ink-950">Join domain after deployment</span><span class="mt-0.5 block text-xs leading-5 text-stone-500">Checking this fills blank fields from FOG’s configured AD defaults and selects its masked default password when available.</span></span></label>
        <% if (adDefaultsError) { %><div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-5 text-amber-900">FOG’s default AD settings could not be loaded. Manual values still work if the configured API user can edit this host.</div><% } else { %><div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3"><p class="text-xs leading-5 text-sky-950">FOG defaults: <strong><%= adDefaults.domain || 'No domain' %></strong><%= adDefaults.username ? ` · ${adDefaults.username}` : '' %><%= adDefaults.hasPassword ? ' · password configured' : ' · no password configured' %></p><button class="button-ghost" type="button" @click="$refs.domain.value = $refs.domain.dataset.default; $refs.ou.value = $refs.ou.dataset.default; $refs.username.value = $refs.username.dataset.default; if (hasDefaultPassword) useDefaultPassword = true">Fill FOG defaults</button></div><% } %>
        <div class="grid gap-5 sm:grid-cols-2">
          <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="ad-domain">Domain name</label><input class="input <%= adErrors.domain ? 'border-red-400' : '' %>" id="ad-domain" name="domain" value="<%= adValues.domain %>" data-default="<%= adDefaults.domain %>" x-ref="domain" maxlength="250" autocomplete="off" :required="enabled"><% if (adErrors.domain) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= adErrors.domain %></p><% } %></div>
          <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="ad-username">Domain join account</label><input class="input <%= adErrors.username ? 'border-red-400' : '' %>" id="ad-username" name="username" value="<%= adValues.username %>" data-default="<%= adDefaults.username %>" x-ref="username" maxlength="250" autocomplete="username" :required="enabled"><p class="mt-1.5 text-xs text-stone-500">A bare username is qualified with the domain; <code>DOMAIN\user</code> and <code>user@domain</code> are also accepted by FOG.</p><% if (adErrors.username) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= adErrors.username %></p><% } %></div>
          <div class="sm:col-span-2"><label class="mb-2 block text-sm font-semibold text-stone-700" for="ad-ou">Organizational unit</label><input class="input <%= adErrors.organizationalUnit ? 'border-red-400' : '' %>" id="ad-ou" name="organizationalUnit" value="<%= adValues.organizationalUnit %>" data-default="<%= adDefaults.organizationalUnit %>" x-ref="ou" maxlength="1024" autocomplete="off"><p class="mt-1.5 text-xs text-stone-500">Optional distinguished name, for example <code>OU=Workstations,DC=example,DC=test</code>.</p><% if (adErrors.organizationalUnit) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= adErrors.organizationalUnit %></p><% } %></div>
          <div class="sm:col-span-2"><label class="mb-2 block text-sm font-semibold text-stone-700" for="ad-password">Domain join password</label><label x-show="enabled && hasDefaultPassword" class="mb-3 flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 bg-stone-50 p-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="useDefaultPassword" value="1" x-model="useDefaultPassword" <%= adValues.useDefaultPassword && adDefaults.hasPassword ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Use FOG default password</span><span class="mt-0.5 block font-mono text-xs tracking-widest text-stone-500">••••••••••••••••</span></span></label><div x-show="!useDefaultPassword"><input class="input <%= adErrors.password ? 'border-red-400' : '' %>" id="ad-password" name="password" type="password" value="" maxlength="250" autocomplete="new-password" :required="enabled && !useDefaultPassword"><p class="mt-1.5 text-xs text-stone-500">Foggy sends a manually entered or server-resolved default password once to FOG, immediately discards the raw response, and never renders the real value.</p></div><% if (adErrors.password) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= adErrors.password %></p><% } %></div>
        </div>
        <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="enforce" value="1" <%= adValues.enforce ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Force hostname/domain changes and reboot</span><span class="mt-0.5 block text-xs leading-5 text-stone-500">Matches FOG’s “Name Change/AD Join Forced reboot” host flag.</span></span></label>
      </div>
      <div class="space-y-4 border-t border-stone-200 p-5 sm:p-6">
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong>Operational effect:</strong> Wrong credentials, domain, or OU values can cause domain joins to fail. Enforce mode may rename and reboot the workstation when the FOG Client applies the change.</div>
        <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">I reviewed the domain, join account, OU, and forced-reboot behavior.</span></label>
      </div>
      <div class="flex justify-end border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:px-6"><button class="button-primary" type="submit">Save Active Directory settings</button></div>
    </div>
    <aside class="space-y-4">
      <div class="panel p-5"><h3 class="text-sm font-semibold text-ink-950">Modern-client scope</h3><p class="mt-2 text-xs leading-5 text-stone-600">This workflow updates <code>useAD</code>, domain, OU, username, modern <code>ADPass</code>, and enforce. The legacy encrypted-password field and product key are always omitted.</p></div>
      <% if (typeof currentFogServer !== 'undefined' && currentFogServer && /^http:\/\//i.test(currentFogServer.baseUrl)) { %><div class="rounded-xl border border-amber-300 bg-amber-50 p-5 text-sm leading-6 text-amber-950"><strong>Unencrypted upstream connection:</strong> This FOG server uses HTTP. The join password travels from Foggy to FOG without TLS on the management network. Configure HTTPS on FOG to protect it in transit.</div><% } %>
      <div class="panel p-5"><h3 class="text-sm font-semibold text-ink-950">Secret handling</h3><ul class="mt-3 space-y-2 text-xs leading-5 text-stone-600"><li>• The browser never receives the existing password.</li><li>• Failed forms clear the password input.</li><li>• Foggy does not log request bodies.</li><li>• The raw FOG response passes through the secret-stripping host normalizer.</li></ul></div>
    </aside>
  </form>
</section>
