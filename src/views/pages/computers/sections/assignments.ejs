<section id="assignments" class="scroll-mt-24">
  <% const assignmentHeading = activeTab === 'groups' ? ['Group memberships', 'Groups currently associated with this computer in FOG.'] : activeTab === 'snapins' ? ['Snapins', 'Assign packages and run them through the FOG Client.'] : ['Printers', 'Configure printers enforced by the FOG Client.']; %>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="section-title"><%= assignmentHeading[0] %></h2><p class="section-description mt-0.5"><%= assignmentHeading[1] %></p></div><% if (activeTab === 'snapins') { %><a class="button-secondary" href="/snapins">Open Snapin library</a><% } %></div>
  <div class="grid gap-5">
    <% if (activeTab === 'groups') { %>
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Groups</h3><p class="section-description mt-0.5"><%= groups.length %> membership<%= groups.length === 1 ? '' : 's' %></p></div></div><div class="divide-y divide-stone-100">
      <% if (sectionErrors.groups) { %><div class="p-4"><%- include('../../../components/alert', { message: sectionErrors.groups }) %></div><% } else if (!groups.length) { %><div class="p-5 text-sm text-stone-500">Not assigned to a group.</div><% } else { %><% for (const group of groups) { %><a class="block px-5 py-4 transition hover:bg-fog-50/50" href="/groups/<%= group.id %>"><div class="text-sm font-semibold text-ink-950"><%= group.name %></div><div class="mt-0.5 text-xs text-stone-500"><%= group.description || `${group.hostCount} computers` %></div></a><% } %><% } %>
    </div></article>
    <% } %>
    <% if (activeTab === 'snapins') { %>
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Assigned Snapins</h3><p class="section-description mt-0.5"><%= snapins.length %> assigned · execution is separate from assignment</p></div><% if (snapins.some((snapin) => snapin.isEnabled)) { %><a class="button-secondary" href="/computers/<%= computer.id %>/snapins/run?snapin=all">Run all assigned</a><% } %></div><div class="divide-y divide-stone-100">
      <% if (sectionErrors.snapins) { %><div class="p-4"><%- include('../../../components/alert', { message: sectionErrors.snapins }) %></div><% } else if (!snapins.length) { %><div class="p-5 text-sm text-stone-500">No Snapins assigned.</div><% } else { %><% for (const snapin of snapins) { %><div class="flex items-start justify-between gap-3 px-5 py-3.5"><div><div class="text-sm font-semibold text-ink-950"><%= snapin.name %></div><div class="mt-0.5 text-xs text-stone-500"><%= snapin.description || snapin.file || 'No description' %></div></div><div class="flex items-center gap-2"><%- include('../../../components/badge', { label: snapin.isEnabled ? 'Enabled' : 'Disabled', tone: snapin.isEnabled ? 'success' : 'neutral' }) %><% if (snapin.isEnabled) { %><a class="text-xs font-semibold text-fog-800 hover:underline" href="/computers/<%= computer.id %>/snapins/run?snapin=<%= snapin.id %>">Run</a><% } %></div></div><% } %><% } %>
    </div></article>
    <% } %>
    <% if (activeTab === 'printers') { %>
    <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Printers</h3><p class="section-description mt-0.5"><%= printers.length %> assigned</p></div><% if (!sectionErrors.printers) { %><a class="button-ghost" href="#printer-assignments">Manage</a><% } %></div><div class="divide-y divide-stone-100">
      <% if (sectionErrors.printers) { %><div class="p-4"><%- include('../../../components/alert', { message: sectionErrors.printers }) %></div><% } else if (!printers.length) { %><div class="p-5 text-sm text-stone-500">No printers assigned.</div><% } else { %><% for (const printer of printers) { %><div class="flex items-start justify-between gap-3 px-5 py-3.5"><div><div class="text-sm font-semibold text-ink-950"><%= printer.name %></div><div class="mt-0.5 text-xs text-stone-500"><%= printer.model || printer.ip || printer.description || 'Printer' %></div></div><% if (printer.isDefault) { %><%- include('../../../components/badge', { label: 'Default', tone: 'info' }) %><% } %></div><% } %><% } %>
    </div></article>
    <% } %>
  </div>
  <% if (activeTab === 'snapins' && !sectionErrors.snapins) { %>
    <div id="snapin-assignments" class="panel mt-5 scroll-mt-24 overflow-hidden">
      <div class="panel-header"><div><h3 class="section-title">Edit assignments</h3><p class="section-description mt-0.5">Check every Snapin that should be assigned to this computer.</p></div><%- include('../../../components/badge', { label: `${selectedSnapinIds.size} selected`, tone: 'info' }) %></div>
      <% if (snapinAssignmentError) { %><div class="mx-5 mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 sm:mx-6" role="alert"><strong>Assignments were not saved:</strong> <%= snapinAssignmentError %></div><% } %>
      <form method="post" action="/computers/<%= computer.id %>/snapins" class="border-t border-stone-200">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (!allSnapins.length) { %><div class="p-5 text-sm text-stone-500 sm:p-6">No Snapin definitions are available on this FOG server.</div><% } else { %>
          <div class="grid max-h-96 overflow-y-auto sm:grid-cols-2 xl:grid-cols-3">
            <% for (const snapin of allSnapins) { %><label class="flex cursor-pointer items-start gap-3 border-b border-stone-100 px-5 py-4 transition hover:bg-fog-50/50 sm:[&:nth-child(odd)]:border-r xl:[&:not(:nth-child(3n))]:border-r"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="snapinIds" value="<%= snapin.id %>" <%= selectedSnapinIds.has(snapin.id) ? 'checked' : '' %>><span class="min-w-0 flex-1"><span class="flex items-center gap-2"><span class="truncate text-sm font-semibold text-ink-950"><%= snapin.name || 'Unnamed Snapin' %></span><%- include('../../../components/badge', { label: snapin.isEnabled ? 'Enabled' : 'Disabled', tone: snapin.isEnabled ? 'success' : 'neutral' }) %></span><span class="mt-1 block truncate text-xs text-stone-500"><%= snapin.description || snapin.file || 'No description' %></span><% if (snapin.file) { %><span class="mt-1 block truncate font-mono text-[11px] text-stone-400"><%= snapin.file %></span><% } %></span></label><% } %>
          </div>
        <% } %>
        <div class="space-y-4 p-5 sm:p-6"><div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm leading-6 text-sky-950"><strong>Assignment only:</strong> Saving does not run a Snapin or alter existing Snapin jobs. Unchecked Snapins will be removed from this computer's future assignment set.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Replace the computer's Snapin assignments with this complete selection.</span></label></div>
        <div class="flex justify-end border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:px-6"><button class="button-primary" type="submit" <%= allSnapins.length ? '' : 'disabled' %>>Save assignments</button></div>
      </form>
    </div>
  <% } %>
  <% if (activeTab === 'printers' && !sectionErrors.printers) { %>
    <details id="printer-assignments" class="panel mt-5 scroll-mt-24 overflow-hidden" <%= printerAssignmentError ? 'open' : '' %> x-data='{ selected: <%- JSON.stringify([...selectedPrinterIds]) %>, defaultPrinter: <%= Number(printerDefaultId) || 0 %> }'>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 transition hover:bg-stone-50 sm:px-6"><span><span class="block text-sm font-semibold text-ink-950">Manage printer configuration</span><span class="mt-0.5 block text-xs text-stone-500">Choose the complete assigned set, client enforcement level, and default printer.</span></span><span class="text-lg text-stone-400" aria-hidden="true">⌄</span></summary>
      <% if (printerAssignmentError) { %><div class="mx-5 mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 sm:mx-6" role="alert"><strong>Printer settings were not fully saved:</strong> <%= printerAssignmentError %></div><% } %>
      <form method="post" action="/computers/<%= computer.id %>/printers" class="border-t border-stone-200">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid gap-5 p-5 sm:p-6 lg:grid-cols-[18rem_1fr]">
          <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="printer-management-level">Client management level</label><select class="input" id="printer-management-level" name="managementLevel"><option value="0" <%= Number(printerManagementLevel) === 0 ? 'selected' : '' %>>No printer management</option><option value="1" <%= Number(printerManagementLevel) === 1 ? 'selected' : '' %>>Manage FOG printers</option><option value="2" <%= Number(printerManagementLevel) === 2 ? 'selected' : '' %>>Only assigned printers</option></select><p class="mt-2 text-xs leading-5 text-stone-500">“Only assigned” also removes printers that were not created in FOG.</p></div>
          <div class="rounded-xl border border-stone-200"><div class="grid grid-cols-[1fr_5rem] border-b border-stone-200 bg-stone-50 px-4 py-2 text-[11px] font-semibold uppercase tracking-wider text-stone-500"><span>Assigned printer</span><span class="text-center">Default</span></div>
            <label class="grid cursor-pointer grid-cols-[1fr_5rem] items-center border-b border-stone-100 px-4 py-3 last:border-0"><span class="text-sm text-stone-600">No default printer</span><span class="text-center"><input class="size-4 accent-fog-700" type="radio" name="defaultPrinterId" value="0" x-model.number="defaultPrinter"></span></label>
            <% if (!allPrinters.length) { %><div class="px-4 py-5 text-sm text-stone-500">No printer definitions are available.</div><% } %>
            <% for (const printer of allPrinters) { %><div class="grid grid-cols-[1fr_5rem] items-center border-b border-stone-100 px-4 py-3 last:border-0"><label class="flex cursor-pointer items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="printerIds" value="<%= printer.id %>" x-model.number="selected" @change="if (!selected.includes(defaultPrinter)) defaultPrinter = 0"><span><span class="block text-sm font-semibold text-ink-950"><%= printer.name || 'Unnamed printer' %></span><span class="mt-0.5 block text-xs text-stone-500"><%= printer.model || printer.ip || printer.description || 'Printer definition' %></span></span></label><span class="text-center"><input class="size-4 accent-fog-700 disabled:opacity-30" type="radio" name="defaultPrinterId" value="<%= printer.id %>" x-model.number="defaultPrinter" :disabled="!selected.includes(<%= printer.id %>)" aria-label="Make <%= printer.name || 'this printer' %> the default"></span></div><% } %>
          </div>
        </div>
        <div class="space-y-4 border-t border-stone-200 p-5 sm:p-6"><div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong>Client-side effect:</strong> On its next check-in, an enabled FOG Client Printer Manager will reconcile printers using this complete assignment set. The “Only assigned printers” level can remove locally configured printers that are not assigned here.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Replace this computer's printer configuration with the reviewed settings.</span></label></div>
        <div class="flex justify-end border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:px-6"><button class="button-primary" type="submit">Save printer configuration</button></div>
      </form>
    </details>
  <% } %>
</section>
