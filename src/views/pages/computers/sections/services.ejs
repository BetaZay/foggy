<section id="services" class="scroll-mt-24">
  <div class="mb-4"><h2 class="section-title"><%= activeTab === 'power' ? 'Power and display' : 'Client services' %></h2><p class="section-description mt-0.5"><%= activeTab === 'power' ? 'Display, session, and scheduled power state reported by FOG.' : 'Choose the FOG Client modules allowed to run on this computer.' %></p></div>
  <div class="grid gap-5 <%= activeTab === 'services' ? '' : 'xl:grid-cols-2' %>">
    <% if (activeTab === 'services') { %>
    <article class="panel overflow-hidden xl:col-span-2"><div class="panel-header"><div><h3 class="section-title">Service modules</h3><p class="section-description mt-0.5">Per-host module state reported by FOG.</p></div><% if (!sectionErrors.services && clientServiceGlobalStatusAvailable) { %><a class="button-ghost" href="#service-modules">Manage</a><% } %></div>
      <% if (sectionErrors.services) { %><div class="p-5"><%- include('../../../components/alert', { message: sectionErrors.services }) %></div><% } else if (!clientServices.length) { %><div class="p-5 text-sm text-stone-500">No client service state found.</div><% } else { %><div class="grid sm:grid-cols-2"><% for (const service of clientServices) { const effective = service.isEnabled && service.globallyEnabled !== false; %><div class="flex items-start justify-between gap-3 border-b border-stone-100 px-5 py-3.5 sm:odd:border-r"><div><div class="text-sm font-semibold text-ink-950"><%= service.name %></div><div class="mt-0.5 text-xs leading-5 text-stone-500"><%= service.description || service.shortName %></div></div><%- include('../../../components/badge', { label: service.globallyEnabled === false ? 'Globally off' : (service.isEnabled ? 'On' : 'Off'), tone: effective ? 'success' : 'neutral' }) %></div><% } %></div><% } %>
      <% if (!sectionErrors.services && !clientServiceGlobalStatusAvailable) { %><div class="border-t border-amber-200 bg-amber-50 px-5 py-3 text-xs leading-5 text-amber-900">Global module status is unavailable from this FOG server. Host module state remains visible, but editing is disabled.</div><% } %>
    </article>
    <% } %>
    <% if (activeTab === 'power') { %><div class="space-y-5">
      <article class="panel p-5"><h3 class="section-title">Display and session</h3><dl class="mt-4 space-y-3"><% const displayDetails = [['Resolution', computer.screen.width && computer.screen.height ? `${computer.screen.width} × ${computer.screen.height}` : 'Default'], ['Refresh rate', computer.screen.refresh ? `${computer.screen.refresh} Hz` : 'Default'], ['Auto logoff', computer.autoLogoffMinutes ? `${computer.autoLogoffMinutes} minutes` : 'Disabled/default']]; %><% for (const detail of displayDetails) { %><div class="flex justify-between gap-4"><dt class="text-xs text-stone-500"><%= detail[0] %></dt><dd class="text-right text-xs font-medium text-stone-800"><%= detail[1] %></dd></div><% } %></dl></article>
      <article class="panel overflow-hidden"><div class="panel-header"><div><h3 class="section-title">Power schedules</h3><p class="section-description mt-0.5"><%= powerSchedules.length %> configured</p></div></div>
        <% if (sectionErrors.power) { %><div class="p-4"><%- include('../../../components/alert', { message: sectionErrors.power }) %></div><% } else if (!powerSchedules.length) { %><div class="p-5 text-sm text-stone-500">No scheduled power actions.</div><% } else { %><div class="divide-y divide-stone-100"><% for (const schedule of powerSchedules) { %><div class="px-5 py-3.5"><div class="flex items-center justify-between gap-3"><span class="text-sm font-semibold capitalize text-ink-950"><%= schedule.action || 'Power action' %></span><%- include('../../../components/badge', { label: schedule.onDemand ? 'On demand' : 'Scheduled', tone: schedule.onDemand ? 'info' : 'warning' }) %></div><% if (!schedule.onDemand) { %><div class="mt-1 font-mono text-[11px] text-stone-500"><%= [schedule.minute, schedule.hour, schedule.dayOfMonth, schedule.month, schedule.dayOfWeek].join(' ') %></div><% } %></div><% } %></div><% } %>
      </article>
    </div><% } %>
  </div>
  <% if (activeTab === 'services' && !sectionErrors.services && clientServiceGlobalStatusAvailable) { %>
    <details id="service-modules" class="panel mt-5 scroll-mt-24 overflow-hidden" <%= clientServiceConfigError ? 'open' : '' %>>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 transition hover:bg-stone-50 sm:px-6"><span><span class="block text-sm font-semibold text-ink-950">Manage FOG Client services</span><span class="mt-0.5 block text-xs text-stone-500">Choose which globally available modules may run on this computer.</span></span><span class="text-lg text-stone-400" aria-hidden="true">⌄</span></summary>
      <% if (clientServiceConfigError) { %><div class="mx-5 mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 sm:mx-6" role="alert"><strong>Client services were not fully saved:</strong> <%= clientServiceConfigError %></div><% } %>
      <form method="post" action="/computers/<%= computer.id %>/services" class="border-t border-stone-200">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid sm:grid-cols-2 xl:grid-cols-3">
          <% for (const service of clientServices) { %><label class="flex items-start gap-3 border-b border-stone-100 px-5 py-4 <%= service.globallyEnabled === true ? 'cursor-pointer hover:bg-fog-50/50' : 'cursor-not-allowed bg-stone-50 opacity-70' %> sm:[&:nth-child(odd)]:border-r xl:[&:not(:nth-child(3n))]:border-r"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="moduleIds" value="<%= service.id %>" <%= selectedClientServiceIds.has(service.id) ? 'checked' : '' %> <%= service.globallyEnabled === true ? '' : 'disabled' %>><span><span class="flex items-center gap-2"><span class="text-sm font-semibold text-ink-950"><%= service.name %></span><%- include('../../../components/badge', { label: service.globallyEnabled === true ? 'Available' : 'Globally off', tone: service.globallyEnabled === true ? 'success' : 'neutral' }) %></span><span class="mt-1 block text-xs leading-5 text-stone-500"><%= service.description || service.shortName %></span></span></label><% } %>
        </div>
        <div class="space-y-4 p-5 sm:p-6"><div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm leading-6 text-sky-950"><strong>Client check-in:</strong> Changes take effect when the FOG Client next checks in. Modules disabled globally remain unchanged and cannot be enabled here.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Replace this computer's available client module settings with the reviewed selection.</span></label></div>
        <div class="flex justify-end border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:px-6"><button class="button-primary" type="submit">Save client services</button></div>
      </form>
    </details>
  <% } %>
</section>
