<% const inventory = computer.inventory; %>
<section id="inventory" class="scroll-mt-24">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="section-title">Hardware inventory</h2><p class="section-description mt-0.5">Inventory collected by FOG from this computer.</p></div><a class="button-secondary" href="/computers/<%= computer.id %>/tasks/new?action=inventory"><%= inventory.id ? 'Refresh inventory' : 'Collect inventory' %></a></div>
  <% if (!inventory.id) { %>
    <%- include('../../../components/empty-state', { heading: 'No inventory collected', description: 'Run a hardware inventory task to populate this section.' }) %>
  <% } else { %>
    <div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
      <% const inventoryCards = [
        ['System', [['Manufacturer', inventory.system.manufacturer], ['Product', inventory.system.product], ['Version', inventory.system.version], ['Serial', inventory.system.serial], ['UUID', inventory.system.uuid], ['Type', inventory.system.type]]],
        ['Processor & memory', [['Processor', inventory.processor.version], ['CPU manufacturer', inventory.processor.manufacturer], ['Current speed', inventory.processor.currentMhz ? `${inventory.processor.currentMhz} MHz` : ''], ['Maximum speed', inventory.processor.maxMhz ? `${inventory.processor.maxMhz} MHz` : ''], ['Memory', inventory.memory]]],
        ['Storage & graphics', [['Disk model', inventory.disk.model], ['Disk serial', inventory.disk.serial], ['Disk firmware', inventory.disk.firmware], ['GPU vendor', inventory.graphics.vendors], ['GPU product', inventory.graphics.products]]],
        ['BIOS', [['Vendor', inventory.bios.vendor], ['Version', inventory.bios.version], ['Date', inventory.bios.date]]],
        ['Motherboard', [['Manufacturer', inventory.motherboard.manufacturer], ['Product', inventory.motherboard.product], ['Version', inventory.motherboard.version], ['Serial', inventory.motherboard.serial], ['Asset tag', inventory.motherboard.assetTag]]]
      ]; %>
      <% for (const card of inventoryCards) { %><article class="panel p-5"><h3 class="text-sm font-semibold text-ink-950"><%= card[0] %></h3><dl class="mt-4 space-y-3"><% for (const item of card[1]) { %><div class="flex items-start justify-between gap-5 border-t border-stone-100 pt-3 first:border-0 first:pt-0"><dt class="text-xs text-stone-500"><%= item[0] %></dt><dd class="max-w-[65%] break-words text-right text-xs font-medium text-stone-800"><%= item[1] || '—' %></dd></div><% } %></dl></article><% } %>
      <form class="panel overflow-hidden" method="post" action="/computers/<%= computer.id %>/inventory">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="border-b border-stone-200 px-5 py-4"><h3 class="text-sm font-semibold text-ink-950">Ownership & asset tags</h3><p class="mt-1 text-xs text-stone-500">Collected <%= formatDate(inventory.collectedAt) %></p></div>
        <div class="space-y-4 p-5">
          <% if (inventoryFormError) { %><div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-800" role="alert"><%= inventoryFormError %></div><% } %>
          <% const inventoryFields = [['primaryUser', 'Primary user'], ['assetTag', 'Asset tag'], ['alternateTag', 'Alternate tag']]; %>
          <% for (const field of inventoryFields) { %><div><label class="mb-1.5 block text-xs font-semibold text-stone-700" for="inventory-<%= field[0] %>"><%= field[1] %></label><input class="input py-2 text-sm <%= inventoryErrors[field[0]] ? 'border-red-400' : '' %>" id="inventory-<%= field[0] %>" name="<%= field[0] %>" value="<%= inventoryValues[field[0]] %>" maxlength="50"><% if (inventoryErrors[field[0]]) { %><p class="mt-1 text-xs font-medium text-red-700"><%= inventoryErrors[field[0]] %></p><% } %></div><% } %>
        </div>
        <div class="flex justify-end border-t border-stone-200 bg-stone-50/70 px-5 py-3"><button class="button-secondary" type="submit">Save inventory details</button></div>
      </form>
    </div>
  <% } %>
</section>
