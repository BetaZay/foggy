<%- include('../../layouts/app-start') %>
<div class="mb-5"><a class="button-ghost -ml-3" href="/computers/<%= computer.id %>#assignments"><%- include('../../components/icon', { name: 'arrow-left', className: 'size-4' }) %>Back to <%= computer.name %></a></div>
<%- include('../../components/page-header', { eyebrow: 'Snapin task', heading: requestedSnapin === 'all' ? 'Run all assigned Snapins' : `Run ${selectedSnapin.name}`, description: computer.name, action: '' }) %>
<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot queue Snapins:</strong> <%= formError %></div><% } %>
<% const blocked = activeTasks.length > 0; const selected = requestedSnapin === 'all' ? snapins.filter((snapin) => snapin.isEnabled) : [selectedSnapin]; %>
<form method="post" action="/computers/<%= computer.id %>/snapins/run" class="max-w-3xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="snapin" value="<%= requestedSnapin %>">
  <section class="panel overflow-hidden"><div class="panel-header"><div><h2 class="section-title"><%= computer.name %></h2><p class="section-description mt-0.5"><%= computer.primaryMac || 'No primary MAC' %></p></div><%- include('../../components/badge', { label: computer.status || 'Unknown', tone: computer.statusTone || 'neutral' }) %></div>
    <div class="space-y-5 p-5 sm:p-6"><div><div class="meta-label mb-2">Snapins to run</div><div class="divide-y divide-stone-100 rounded-xl border border-stone-200"><% for (const snapin of selected) { %><div class="flex items-start justify-between gap-4 px-4 py-3"><div><div class="text-sm font-semibold text-ink-950"><%= snapin.name %></div><div class="mt-0.5 text-xs text-stone-500"><%= snapin.description || snapin.file || 'No description' %></div></div><div class="flex gap-2"><% if (snapin.reboot) { %><span class="badge-warning">Reboot</span><% } %><% if (snapin.shutdown) { %><span class="badge-warning">Shutdown</span><% } %></div></div><% } %></div></div>
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong>Client-side execution:</strong> FOG Client will download and execute the selected package commands. Reboot or shutdown behavior is controlled by each Snapin definition.</div>
      <% if (blocked) { %><p class="text-sm font-semibold text-red-700">This computer already has an active task. Foggy will not replace or merge it.</p><% } %>
      <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required <%= blocked ? 'disabled' : '' %>><span class="text-sm font-medium text-stone-700">Queue <%= requestedSnapin === 'all' ? 'these Snapins' : 'this Snapin' %> for execution by FOG Client.</span></label>
    </div><div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="/computers/<%= computer.id %>#assignments">Cancel</a><button class="button-primary" type="submit" <%= blocked ? 'disabled' : '' %>>Queue Snapin task</button></div>
  </section>
</form>
<%- include('../../layouts/app-end') %>
