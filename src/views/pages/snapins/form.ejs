<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot save this Snapin:</strong> <%= formError %></div><% } %>
<form method="post" action="<%= action %>" class="max-w-5xl" <% if (creating) { %>enctype="multipart/form-data"<% } %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel overflow-hidden">
    <div class="panel-header"><div><h2 class="section-title">Snapin definition</h2><p class="section-description mt-0.5">Configure how FOG Client executes this package.</p></div></div>
    <div class="grid gap-6 p-5 sm:p-6 md:grid-cols-2">
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="name">Snapin name</label><input class="input <%= errors.name ? 'border-red-400' : '' %>" id="name" name="name" maxlength="200" value="<%= values.name %>" autofocus required><% if (errors.name) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.name %></p><% } %></div>
      <% if (creating) { %><div><label class="mb-2 block text-sm font-semibold text-stone-700" for="installer">Installer file</label><input class="input cursor-pointer file:mr-4 file:rounded-md file:border-0 file:bg-fog-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-fog-800 <%= errors.installer ? 'border-red-400' : '' %>" id="installer" name="installer" type="file"><p class="mt-1.5 text-xs text-stone-500">Foggy temporarily receives one file and forwards it directly to FOG's master storage node.</p><% if (errors.installer) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.installer %></p><% } %></div><% } %>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="file"><%= creating ? 'Or use an existing stored filename' : 'Stored filename' %></label><input class="input font-mono <%= errors.file ? 'border-red-400' : '' %>" id="file" name="file" value="<%= values.file %>" placeholder="install-agent.msi" <%= creating ? '' : 'required' %>><p class="mt-1.5 text-xs text-stone-500"><%= creating ? 'Leave blank when uploading. Otherwise enter a basename already in the selected storage group.' : 'A basename in the storage group’s Snapin directory; paths are not accepted.' %></p><% if (errors.file) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.file %></p><% } %></div>
      <div class="md:col-span-2"><label class="mb-2 block text-sm font-semibold text-stone-700" for="description">Description</label><textarea class="input min-h-24 py-3" id="description" name="description" rows="3"><%= values.description %></textarea></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="packageType">Package type</label><select class="input <%= errors.packageType ? 'border-red-400' : '' %>" id="packageType" name="packageType"><option value="0" <%= Number(values.packageType) === 0 ? 'selected' : '' %>>Normal Snapin</option><option value="1" <%= Number(values.packageType) === 1 ? 'selected' : '' %>>Snapin Pack</option></select><% if (errors.packageType) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.packageType %></p><% } %></div>
      <% if (creating) { %><div><label class="mb-2 block text-sm font-semibold text-stone-700" for="storageGroupId">Storage group</label><select class="input <%= errors.storageGroupId ? 'border-red-400' : '' %>" id="storageGroupId" name="storageGroupId" required><% for (const group of lookups.storageGroups) { %><option value="<%= group.id %>" <%= Number(values.storageGroupId) === group.id ? 'selected' : '' %>><%= group.name %></option><% } %></select><% if (errors.storageGroupId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.storageGroupId %></p><% } %></div><% } else { %><div><label class="mb-2 block text-sm font-semibold text-stone-700">Storage group</label><div class="input flex items-center bg-stone-50 text-stone-600"><%= snapin.storageGroup || 'FOG default' %></div><p class="mt-1.5 text-xs text-stone-500">Storage associations are preserved by this form.</p></div><% } %>
      <div class="md:col-span-2"><label class="mb-2 block text-sm font-semibold text-stone-700" for="arguments">Snapin arguments</label><input class="input font-mono <%= errors.arguments ? 'border-red-400' : '' %>" id="arguments" name="arguments" value="<%= values.arguments %>" autocomplete="off"><% if (errors.arguments) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.arguments %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="runWith">Run with</label><input class="input font-mono <%= errors.runWith ? 'border-red-400' : '' %>" id="runWith" name="runWith" value="<%= values.runWith %>" placeholder="msiexec.exe"><% if (errors.runWith) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.runWith %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="runWithArguments">Run-with arguments</label><input class="input font-mono <%= errors.runWithArguments ? 'border-red-400' : '' %>" id="runWithArguments" name="runWithArguments" value="<%= values.runWithArguments %>" placeholder="/i"><% if (errors.runWithArguments) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.runWithArguments %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="timeoutSeconds">Timeout (seconds)</label><input class="input <%= errors.timeoutSeconds ? 'border-red-400' : '' %>" id="timeoutSeconds" name="timeoutSeconds" type="number" min="0" max="2147483647" step="1" value="<%= values.timeoutSeconds %>" required><p class="mt-1.5 text-xs text-stone-500">Use 0 for FOG's default behavior.</p><% if (errors.timeoutSeconds) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.timeoutSeconds %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="postAction">After execution</label><select class="input <%= errors.postAction ? 'border-red-400' : '' %>" id="postAction" name="postAction"><option value="none" <%= values.postAction === 'none' ? 'selected' : '' %>>Do nothing</option><option value="reboot" <%= values.postAction === 'reboot' ? 'selected' : '' %>>Reboot computer</option><option value="shutdown" <%= values.postAction === 'shutdown' ? 'selected' : '' %>>Shut down computer</option></select><% if (errors.postAction) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.postAction %></p><% } %></div>
      <div class="rounded-xl border border-stone-200 bg-stone-50/70 p-4 md:col-span-2"><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="isEnabled" value="1" <%= values.isEnabled ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Enabled</span><span class="mt-0.5 block text-xs text-stone-500">Allow assignment and execution.</span></span></label>
        <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="replicates" value="1" <%= values.replicates ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Replicate</span><span class="mt-0.5 block text-xs text-stone-500">Distribute through FOG storage.</span></span></label>
        <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="hidesArguments" value="1" <%= values.hidesArguments ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Hide arguments</span><span class="mt-0.5 block text-xs text-stone-500">Suppress arguments in client logs.</span></span></label>
        <% if (!creating) { %><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="isProtected" value="1" <%= values.isProtected ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Protected</span><span class="mt-0.5 block text-xs text-stone-500">Protect destructive management actions.</span></span></label><% } %>
      </div></div>
    </div>
    <div class="space-y-4 border-t border-stone-200 p-5 sm:p-6"><div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong><%= creating ? 'Storage write:' : 'Definition change:' %></strong> <%= creating ? 'When a file is selected, FOG replaces any same-named file on the storage group’s master node, computes its hash and size, and creates the definition. A late database failure can leave the uploaded file on storage. Without a selected file, Foggy creates metadata referencing the existing filename instead.' : 'Changing the filename only changes what FOG Client will request. Foggy does not rename, move, upload, replace, or delete storage files, and existing host assignments are preserved.' %></div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700"><%= creating ? 'Upload or reference this installer and create the Snapin in FOG.' : 'Apply these execution settings to FOG.' %></span></label></div>
    <div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="/snapins">Cancel</a><button class="button-primary" type="submit"><%= creating ? 'Create Snapin' : 'Save Snapin' %></button></div>
  </section>
</form>
