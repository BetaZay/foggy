<%- include('../../layouts/app-start') %>
<%- include('../../components/page-header', { eyebrow: 'Software library', heading: 'Snapins', description: 'Packages FOG Client can execute independently or after deployment.', action: '<a class="button-primary" href="/snapins/new">Create Snapin</a>' }) %>
<% if (error) { %><%- include('../../components/alert', { message: error }) %><% } %>
<% if (!snapins.length) { %><%- include('../../components/empty-state', { heading: 'No Snapins found', description: 'Snapins created in FOG will appear here.' }) %><% } else { %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><% for (const snapin of snapins) { %><article class="panel flex flex-col p-5"><div class="flex items-start justify-between gap-4"><div class="grid size-10 place-items-center rounded-lg bg-violet-50 text-violet-700 ring-1 ring-inset ring-violet-200"><%- include('../../components/icon', { name: 'archive', className: 'size-5' }) %></div><%- include('../../components/badge', { label: snapin.isEnabled ? 'Enabled' : 'Disabled', tone: snapin.isEnabled ? 'success' : 'neutral' }) %></div><h2 class="mt-4 text-base font-semibold text-ink-950"><%= snapin.name || 'Unnamed Snapin' %></h2><p class="mt-1 min-h-10 text-sm leading-5 text-stone-500"><%= snapin.description || snapin.file || 'No description' %></p><dl class="mt-5 grid grid-cols-2 gap-4 border-t border-stone-100 pt-4"><div><dt class="meta-label normal-case tracking-normal">Package</dt><dd class="meta-value mt-1"><%= snapin.packageType === 1 ? 'Snapin Pack' : 'Normal' %></dd></div><div><dt class="meta-label normal-case tracking-normal">Size</dt><dd class="meta-value mt-1"><%= formatBytes(snapin.size) %></dd></div><div><dt class="meta-label normal-case tracking-normal">Storage</dt><dd class="meta-value mt-1"><%= snapin.storageGroup || '—' %></dd></div><div><dt class="meta-label normal-case tracking-normal">Timeout</dt><dd class="meta-value mt-1"><%= snapin.timeoutSeconds ? `${snapin.timeoutSeconds}s` : 'Default' %></dd></div></dl><div class="mt-4 flex flex-wrap gap-2"><% if (snapin.reboot) { %><span class="badge-warning">Reboots</span><% } %><% if (snapin.shutdown) { %><span class="badge-warning">Shuts down</span><% } %><% if (snapin.replicates) { %><span class="badge-info">Replicates</span><% } %></div><div class="mt-auto border-t border-stone-100 pt-4"><a class="button-secondary w-full" href="/snapins/<%= snapin.id %>/edit">Edit Snapin</a></div></article><% } %></div>
  <p class="count-label"><%= snapins.length %> Snapin<%= snapins.length === 1 ? '' : 's' %></p>
<% } %>
<%- include('../../layouts/app-end') %>
