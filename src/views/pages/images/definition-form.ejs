<section id="image-settings" class="mt-8 scroll-mt-24">
  <div class="mb-4"><h2 class="section-title">Edit image definition</h2></div>
  <% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot update this image:</strong> <%= formError %></div><% } %>
  <form method="post" action="/images/<%= image.id %>" class="max-w-5xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel overflow-hidden">
      <div class="panel-header"><div><h3 class="section-title">Definition settings</h3><p class="section-description mt-0.5">These settings affect future deployments and captures.</p></div></div>
      <div class="grid gap-6 p-5 sm:p-6 md:grid-cols-2">
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="name">Image name</label><input class="input <%= errors.name ? 'border-red-400' : '' %>" id="name" name="name" value="<%= values.name %>" required><% if (errors.name) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.name %></p><% } %></div>
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="path">Storage path</label><input class="input font-mono <%= errors.path ? 'border-red-400' : '' %>" id="path" name="path" value="<%= values.path %>" required><p class="mt-1.5 text-xs text-amber-700">Changing this value does not move existing files on storage nodes.</p><% if (errors.path) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.path %></p><% } %></div>
        <div class="md:col-span-2"><label class="mb-2 block text-sm font-semibold text-stone-700" for="description">Description</label><textarea class="input min-h-24 py-3" id="description" name="description" rows="3"><%= values.description %></textarea></div>
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="osId">Operating system</label><select class="input" id="osId" name="osId" required><% for (const option of lookups.operatingSystems) { %><option value="<%= option.id %>" <%= Number(values.osId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.osId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.osId %></p><% } %></div>
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="imageTypeId">Image type</label><select class="input" id="imageTypeId" name="imageTypeId" required><% for (const option of lookups.imageTypes) { %><option value="<%= option.id %>" <%= Number(values.imageTypeId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.imageTypeId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.imageTypeId %></p><% } %></div>
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="partitionTypeId">Partition layout</label><select class="input" id="partitionTypeId" name="partitionTypeId" required><% for (const option of lookups.partitionTypes) { %><option value="<%= option.id %>" <%= Number(values.partitionTypeId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.partitionTypeId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.partitionTypeId %></p><% } %></div>
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="format">Image format</label><select class="input" id="format" name="format"><% const formatOptions = [[0, 'Partclone Gzip'], [1, 'Partimage'], [2, 'Partclone Gzip split'], [3, 'Partclone uncompressed'], [4, 'Partclone uncompressed split'], [5, 'Partclone Zstd'], [6, 'Partclone Zstd split']]; %><% for (const option of formatOptions) { %><option value="<%= option[0] %>" <%= Number(values.format) === option[0] ? 'selected' : '' %>><%= option[1] %></option><% } %></select><% if (errors.format) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.format %></p><% } %></div>
        <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="compression">Compression level</label><input class="input" id="compression" name="compression" type="number" min="0" max="22" value="<%= values.compression %>" required><% if (errors.compression) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.compression %></p><% } %></div>
        <div class="rounded-xl border border-stone-200 bg-stone-50/70 p-4 md:col-span-2"><div class="grid gap-4 sm:grid-cols-3">
          <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="isEnabled" value="1" <%= values.isEnabled ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Enabled</span><span class="mt-0.5 block text-xs text-stone-500">Available for imaging workflows.</span></span></label>
          <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="isProtected" value="1" <%= values.isProtected ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Protected</span><span class="mt-0.5 block text-xs text-stone-500">Block capture overwrite.</span></span></label>
          <label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="replicates" value="1" <%= values.replicates ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Replicate</span><span class="mt-0.5 block text-xs text-stone-500">Distribute to associated nodes.</span></span></label>
        </div></div>
      </div>
      <div class="space-y-4 border-t border-stone-200 p-5 sm:p-6"><div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong>Definition change:</strong> Foggy will not move or delete stored image files, change storage-group associations, or edit assigned hosts. The update is refused while FOG reports an active task for this image.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Apply these definition settings to FOG.</span></label></div>
      <div class="flex gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:justify-end sm:px-6"><button class="button-primary" type="submit">Save image</button></div>
    </div>
  </form>
</section>
