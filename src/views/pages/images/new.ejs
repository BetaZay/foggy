<%- include('../../layouts/app-start') %>
<div class="mb-5"><a class="button-ghost -ml-3" href="/capture"><%- include('../../components/icon', { name: 'arrow-left', className: 'size-4' }) %>Back to Capture</a></div>
<%- include('../../components/page-header', { eyebrow: 'Image library', heading: 'Create image definition', description: 'Create the FOG metadata and storage association first, then continue into guided Capture.', action: '' }) %>
<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot create image:</strong> <%= formError %></div><% } %>
<form method="post" action="/images" class="max-w-4xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel overflow-hidden"><div class="panel-header"><div><h2 class="section-title">Definition</h2><p class="section-description mt-0.5">This creates metadata only. No disk data is captured until the next confirmed step.</p></div></div>
    <div class="grid gap-6 p-5 sm:p-6 md:grid-cols-2">
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="name">Image name</label><input class="input <%= errors.name ? 'border-red-400' : '' %>" id="name" name="name" value="<%= values.name %>" required><% if (errors.name) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.name %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="path">Storage path</label><input class="input font-mono <%= errors.path ? 'border-red-400' : '' %>" id="path" name="path" value="<%= values.path %>" placeholder="windows-11-lab" required><p class="mt-1.5 text-xs text-stone-500">Relative to the storage node's image directory.</p><% if (errors.path) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.path %></p><% } %></div>
      <div class="md:col-span-2"><label class="mb-2 block text-sm font-semibold text-stone-700" for="description">Description</label><textarea class="input min-h-24 py-3" id="description" name="description" rows="3"><%= values.description %></textarea></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="osId">Operating system</label><select class="input" id="osId" name="osId" required><% for (const option of lookups.operatingSystems) { %><option value="<%= option.id %>" <%= Number(values.osId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.osId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.osId %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="storageGroupId">Storage group</label><select class="input" id="storageGroupId" name="storageGroupId" required><% for (const option of lookups.storageGroups) { %><option value="<%= option.id %>" <%= Number(values.storageGroupId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.storageGroupId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.storageGroupId %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="imageTypeId">Image type</label><select class="input" id="imageTypeId" name="imageTypeId" required><% for (const option of lookups.imageTypes) { %><option value="<%= option.id %>" <%= Number(values.imageTypeId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.imageTypeId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.imageTypeId %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="partitionTypeId">Partition layout</label><select class="input" id="partitionTypeId" name="partitionTypeId" required><% for (const option of lookups.partitionTypes) { %><option value="<%= option.id %>" <%= Number(values.partitionTypeId) === option.id ? 'selected' : '' %>><%= option.name %></option><% } %></select><% if (errors.partitionTypeId) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.partitionTypeId %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="format">Image format</label><select class="input" id="format" name="format"><% const formats = [[0, 'Partclone Gzip'], [1, 'Partimage'], [2, 'Partclone Gzip split'], [3, 'Partclone uncompressed'], [4, 'Partclone uncompressed split'], [5, 'Partclone Zstd'], [6, 'Partclone Zstd split']]; %><% for (const option of formats) { %><option value="<%= option[0] %>" <%= Number(values.format) === option[0] ? 'selected' : '' %>><%= option[1] %></option><% } %></select><% if (errors.format) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.format %></p><% } %></div>
      <div><label class="mb-2 block text-sm font-semibold text-stone-700" for="compression">Compression level</label><input class="input" id="compression" name="compression" type="number" min="0" max="22" value="<%= values.compression %>" required><p class="mt-1.5 text-xs text-stone-500">0 is fastest/largest; 22 is smallest/slowest where supported.</p><% if (errors.compression) { %><p class="mt-1.5 text-xs font-medium text-red-700"><%= errors.compression %></p><% } %></div>
      <label class="flex items-start gap-3 md:col-span-2"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="replicates" value="1" <%= values.replicates ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Replicate this image</span><span class="mt-0.5 block text-xs text-stone-500">Allow FOG's image replicator to distribute captured data to other nodes in the storage group.</span></span></label>
    </div>
    <div class="space-y-4 border-t border-stone-200 p-5 sm:p-6"><div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm leading-6 text-sky-950"><strong>Definition only:</strong> Creating this record does not upload or overwrite image data. Foggy will return to Capture with this destination selected.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">Create this image definition and storage-group association in FOG.</span></label></div>
    <div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="/capture">Cancel</a><button class="button-primary" type="submit">Create and continue</button></div>
  </section>
</form>
<%- include('../../layouts/app-end') %>
