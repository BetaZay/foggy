<% if (error) { %><%- include('../../components/alert', { message: error }) %><% } %>
<% if (!images.length) { %>
  <%- include('../../components/empty-state', { heading: search ? 'No matching images' : 'No images found', description: search ? 'Try a broader image name.' : 'FOG images will appear here.' }) %>
<% } else { %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% for (const image of images) { %>
      <article class="panel flex flex-col p-5 transition duration-150 hover:-translate-y-0.5 hover:border-fog-200 hover:shadow-md">
        <div class="flex items-start justify-between gap-4"><div class="grid size-10 shrink-0 place-items-center rounded-lg bg-fog-50 text-fog-700 ring-1 ring-inset ring-fog-200"><%- include('../../components/icon', { name: 'images', className: 'size-5' }) %></div><%- include('../../components/badge', { label: image.isEnabled ? 'Enabled' : 'Disabled', tone: image.isEnabled ? 'success' : 'neutral' }) %></div>
        <h2 class="mt-4 text-base font-semibold tracking-[-0.01em] text-ink-950"><a class="hover:text-fog-700 hover:underline" href="/images/<%= image.id %>"><%= image.name || 'Unnamed image' %></a></h2>
        <p class="mt-1 min-h-10 text-sm leading-5 text-stone-500"><%= image.description || 'No description' %></p>
        <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-stone-100 pt-4 text-sm">
          <div><dt class="meta-label normal-case tracking-normal">Operating system</dt><dd class="meta-value mt-1"><%= image.operatingSystem || '—' %></dd></div>
          <div><dt class="meta-label normal-case tracking-normal">Image type</dt><dd class="meta-value mt-1"><%= image.imageType || '—' %></dd></div>
          <div><dt class="meta-label normal-case tracking-normal">Storage</dt><dd class="meta-value mt-1"><%= image.storageGroup || '—' %></dd></div>
          <div><dt class="meta-label normal-case tracking-normal">Server size</dt><dd class="meta-value mt-1 tabular-nums"><%= formatBytes(image.size) %></dd></div>
        </dl>
        <div class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4"><a class="text-xs font-semibold text-fog-800 hover:underline" href="/images/<%= image.id %>">View details</a><a class="text-xs font-semibold text-stone-500 hover:text-fog-800" href="/deploy?image=<%= image.id %>">Deploy</a><a class="text-xs font-semibold text-stone-500 hover:text-fog-800" href="/capture?image=<%= image.id %>">Capture</a></div>
      </article>
    <% } %>
  </div>
  <p class="count-label"><%= images.length %> image<%= images.length === 1 ? '' : 's' %></p>
<% } %>
