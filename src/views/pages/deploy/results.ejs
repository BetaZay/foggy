<%- include('../../layouts/app-start') %>
<%- include('../../components/page-header', { eyebrow: 'Deployment request', heading: 'Deployment results', description: `${result.queued} queued · ${result.failed} not queued`, action: '<a class="button-secondary" href="/deploy">Start another deployment</a>' }) %>
<div class="mb-6 grid gap-4 sm:grid-cols-3"><div class="stat-card"><div class="text-sm font-medium text-stone-500">Image</div><div class="mt-3 truncate text-xl font-bold text-ink-950"><%= result.image.name %></div></div><div class="stat-card"><div class="text-sm font-medium text-stone-500">Queued</div><div class="stat-value text-emerald-700"><%= result.queued %></div></div><div class="stat-card"><div class="text-sm font-medium text-stone-500">Not queued</div><div class="stat-value <%= result.failed ? 'text-red-700' : '' %>"><%= result.failed %></div></div></div>
<% if (result.failed) { %><%- include('../../components/alert', { heading: 'Review required:', message: 'At least one computer was not queued. The table states whether its image assignment changed before the failure.' }) %><% } else { %><%- include('../../components/alert', { heading: 'Deployment queued:', message: 'FOG accepted a deployment task for every selected computer.', tone: 'success' }) %><% } %>
<div class="table-card"><div class="table-scroll"><table class="data-table min-w-[900px]"><thead><tr><th class="table-head">Computer</th><th class="table-head">Result</th><th class="table-head">Image assignment changed</th><th class="table-head">Details</th></tr></thead><tbody><% for (const outcome of result.outcomes) { const tone = outcome.status === 'queued' ? 'success' : outcome.status === 'skipped' ? 'warning' : 'danger'; %><tr class="table-row"><td class="table-cell"><a class="font-semibold text-fog-800 hover:underline" href="/computers/<%= outcome.host.id %>"><%= outcome.host.name || 'Unnamed host' %></a><div class="mt-0.5 font-mono text-[11px] text-stone-400"><%= outcome.host.primaryMac || '—' %></div></td><td class="table-cell"><%- include('../../components/badge', { label: outcome.status === 'queued' ? 'Queued' : outcome.status === 'skipped' ? 'Skipped' : 'Failed', tone }) %></td><td class="table-cell"><%= outcome.imageChanged ? 'Yes' : 'No' %></td><td class="table-cell text-stone-600"><%= outcome.message %></td></tr><% } %></tbody></table></div></div>
<div class="mt-6 flex justify-end"><a class="button-primary" href="/tasks">View tasks</a></div>
<%- include('../../layouts/app-end') %>
