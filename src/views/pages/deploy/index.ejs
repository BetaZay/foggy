<%- include('../../layouts/app-start') %>
<%- include('../../components/page-header', {
  eyebrow: 'Guided imaging', heading: 'Deploy an image',
  description: 'Select computers, choose one image, review the options, and queue the work as a single technician workflow.',
  action: ''
}) %>
<% if (formError) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><strong>Cannot deploy:</strong> <%= formError %></div><% } %>
<% const eligibleIds = computers.filter((computer) => !computer.hasActiveTask).map((computer) => computer.id); %>
<form method="post" action="/deploy" class="space-y-6" x-data='{ selected: <%- JSON.stringify(values.hostIds) %> }'>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel overflow-hidden">
    <div class="panel-header"><div><div class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-fog-700 text-xs font-bold text-white">1</span><h2 class="section-title">Select computers</h2></div><p class="section-description mt-1">Computers with active tasks are locked and will not be changed.</p></div><div class="flex gap-2"><button type="button" class="button-ghost" @click='selected = <%- JSON.stringify(eligibleIds) %>'>Select available</button><button type="button" class="button-ghost" @click="selected = []">Clear</button></div></div>
    <% if (!computers.length) { %><div class="p-5 text-sm text-stone-500">No registered computers are available.</div><% } else { %><div class="grid sm:grid-cols-2 xl:grid-cols-3"><% for (const computer of computers) { %><label class="flex items-start gap-3 border-b border-stone-100 px-5 py-4 transition <%= computer.hasActiveTask ? 'cursor-not-allowed bg-stone-50 opacity-65' : 'cursor-pointer hover:bg-fog-50/50' %> sm:odd:border-r xl:[&:not(:nth-child(3n))]:border-r"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="hostIds" value="<%= computer.id %>" x-model.number="selected" <%= computer.hasActiveTask ? 'disabled' : '' %>><span class="min-w-0 flex-1"><span class="flex items-center justify-between gap-2"><span class="truncate text-sm font-semibold text-ink-950"><%= computer.name || 'Unnamed host' %></span><% if (computer.hasActiveTask) { %><span class="badge-warning">Busy</span><% } %></span><span class="mt-0.5 block truncate font-mono text-[11px] text-stone-500"><%= computer.primaryMac || 'No MAC' %></span><span class="mt-1 block truncate text-xs text-stone-400"><%= computer.imageName ? `Currently: ${computer.imageName}` : 'No image assigned' %></span></span></label><% } %></div><% } %>
    <div class="border-t border-stone-200 bg-stone-50/70 px-5 py-3 text-sm font-semibold text-stone-700"><span x-text="selected.length"><%= values.hostIds.length %></span> computer<span x-show="selected.length !== 1">s</span> selected</div>
  </section>

  <section class="panel overflow-hidden">
    <div class="panel-header"><div><div class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-fog-700 text-xs font-bold text-white">2</span><h2 class="section-title">Choose an image</h2></div><p class="section-description mt-1">Foggy updates each selected host's assignment before creating its task.</p></div></div>
    <% if (!images.length) { %><div class="p-5 text-sm text-red-700">No enabled images are available for deployment.</div><% } else { %><div class="grid gap-3 p-5 md:grid-cols-2 xl:grid-cols-3"><% for (const image of images) { %><label class="cursor-pointer rounded-xl border border-stone-200 p-4 transition hover:border-fog-400 hover:bg-fog-50/40 has-[:checked]:border-fog-600 has-[:checked]:bg-fog-50 has-[:checked]:ring-1 has-[:checked]:ring-fog-600"><div class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="radio" name="imageId" value="<%= image.id %>" <%= Number(values.imageId) === image.id ? 'checked' : '' %> required><span><span class="block text-sm font-semibold text-ink-950"><%= image.name %></span><span class="mt-1 block text-xs leading-5 text-stone-500"><%= image.description || image.operatingSystem || 'No description' %></span><span class="mt-2 block text-[11px] text-stone-400"><%= image.imageType || 'Image' %> · <%= image.storageGroup || 'Default storage' %></span></span></div></label><% } %></div><% } %>
  </section>

  <section class="panel overflow-hidden">
    <div class="panel-header"><div><div class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-fog-700 text-xs font-bold text-white">3</span><h2 class="section-title">Deployment options</h2></div></div>
    <div class="grid gap-4 p-5 md:grid-cols-3"><label class="flex items-start gap-3 rounded-xl border border-stone-200 p-4"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="includeSnapins" value="1" <%= values.includeSnapins ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Deploy Snapins</span><span class="mt-1 block text-xs leading-5 text-stone-500">Queue every Snapin assigned to each computer after imaging.</span></span></label><label class="flex items-start gap-3 rounded-xl border border-stone-200 p-4"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="wake" value="1" <%= values.wake ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Wake computers</span><span class="mt-1 block text-xs leading-5 text-stone-500">Send Wake-on-LAN when each deployment is queued.</span></span></label><label class="flex items-start gap-3 rounded-xl border border-stone-200 p-4"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="shutdown" value="1" <%= values.shutdown ? 'checked' : '' %>><span><span class="block text-sm font-semibold text-stone-800">Shut down afterward</span><span class="mt-1 block text-xs leading-5 text-stone-500">Ask FOG to shut down each computer when imaging completes.</span></span></label></div>
  </section>

  <section class="panel overflow-hidden">
    <div class="space-y-4 p-5 sm:p-6"><div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-950"><strong>Destructive operation:</strong> Deployment overwrites the target disk on every computer whose task is successfully queued. If task creation fails after an image assignment changes, Foggy reports that computer explicitly and does not silently roll the assignment back.</div><label class="flex items-start gap-3"><input class="mt-1 size-4 accent-fog-700" type="checkbox" name="confirm" value="1" required><span class="text-sm font-medium text-stone-700">I reviewed the selected computers and image, and I authorize Foggy to update assignments and queue deployment tasks.</span></label></div>
    <div class="flex flex-col-reverse gap-3 border-t border-stone-200 bg-stone-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6"><a class="button-secondary" href="/">Cancel</a><button class="button-danger" type="submit">Deploy to selected computers</button></div>
  </section>
</form>
<%- include('../../layouts/app-end') %>
