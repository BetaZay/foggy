<% if (error) { %><%- include('../../components/alert', { message: error }) %><% } %>
<% if (!tasks.length) { %>
  <%- include('../../components/empty-state', { heading: `No ${status === 'all' ? '' : status + ' '}tasks`, description: '' }) %>
<% } else { %>
  <div class="table-card"><div class="table-scroll">
    <table class="data-table min-w-[900px]">
      <thead><tr><th class="table-head">Computer</th><th class="table-head">Task</th><th class="table-head">Image</th><th class="table-head">Started</th><th class="table-head">State</th><th class="table-head">Progress</th><th class="table-head"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        <% for (const task of tasks) { const hasTransfer = task.dataCopied || task.dataTotal || task.bytesPerMinute; %><tr class="table-row"><td class="table-cell font-semibold text-ink-950"><% if (task.host.id) { %><a class="text-fog-800 hover:underline" href="/computers/<%= task.host.id %>"><%= task.host.name || 'Unknown host' %></a><% } else { %><%= task.host.name || 'Unknown host' %><% } %></td><td class="table-cell"><%= task.type.name || task.name || 'Task' %></td><td class="table-cell text-stone-500"><%= task.image.name || '—' %></td><td class="table-cell text-stone-500"><%= formatDate(task.checkedInAt || task.createdAt) %></td><td class="table-cell"><%- include('../../components/badge', { label: task.state.name, tone: task.tone }) %></td><td class="table-cell"><%- include('../../components/progress', { progress: task.progress, label: task.category === 'queued' ? 'Queued' : task.category === 'running' ? 'Imaging' : 'Progress' }) %><% if (task.elapsed || task.remaining || hasTransfer) { %><div class="mt-2 flex min-w-56 flex-wrap gap-x-3 gap-y-1 text-[11px] tabular-nums text-stone-500"><% if (task.elapsed) { %><span>Elapsed <%= task.elapsed %></span><% } %><% if (task.remaining) { %><span>Remaining <%= task.remaining %></span><% } %><% if (task.dataCopied || task.dataTotal) { %><span><%= task.dataCopied || '—' %> / <%= task.dataTotal || '—' %></span><% } %><% if (task.bytesPerMinute) { %><span><%= formatBytesPerMinute(task.bytesPerMinute) %></span><% } %></div><% } else if (task.category === 'running') { %><p class="mt-2 text-[11px] text-stone-500">Waiting for progress data</p><% } %></td><td class="table-cell text-right"><% if (['queued', 'running'].includes(task.category) && task.host.id) { %><a class="text-xs font-semibold text-red-700 hover:underline" href="/computers/<%= task.host.id %>/tasks/new?action=cancel">Cancel</a><% } %></td></tr><% } %>
      </tbody>
    </table></div>
  </div>
<% } %>
