<%- include('../../layouts/app-start') %>
<% const isLiveStatus = ['active', 'running', 'queued'].includes(status); %>
<%- include('../../components/page-header', { eyebrow: 'Operations', heading: 'Tasks', description: '', action: isLiveStatus ? '<span class="badge-info"><span class="size-1.5 rounded-full bg-current opacity-70"></span>Live</span>' : '' }) %>
<nav class="section-nav mb-6" aria-label="Task status filters"><% const filters = [['active', 'Active'], ['running', 'Running'], ['queued', 'Queued'], ['completed', 'Completed'], ['failed', 'Failed'], ['cancelled', 'Cancelled'], ['all', 'All records']]; %><% for (const filter of filters) { %><a href="/tasks?status=<%= filter[0] %>" class="<%= status === filter[0] ? 'bg-fog-100 text-fog-900' : '' %>" <%= status === filter[0] ? 'aria-current="page"' : '' %>><%= filter[1] %></a><% } %></nav>
<div id="task-results" <% if (isLiveStatus) { %>hx-get="/tasks?status=<%= status %>" hx-trigger="every 10s [document.visibilityState === 'visible']" hx-swap="innerHTML"<% } %>><%- include('results', { tasks, multicastSessions, error, status }) %></div>
<%- include('../../layouts/app-end') %>
